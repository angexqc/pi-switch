{
  "name": "piswitch",
  "productName": "PiSwitch",
  "version": "1.0.0",
  "description": "多 AI 编码工具配置切换与用量统计桌面应用 (pi / Codex / Claude Code / opencode)",
  "author": "PiSwitch",
  "license": "MIT",
  "main": "dist/main/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "smol-toml": "^1.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "echarts": "^5.6.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
